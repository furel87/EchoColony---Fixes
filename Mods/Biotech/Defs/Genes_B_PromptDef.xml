    <targetGene>Pain_Reduced</targetGene>
    <customLabel>reduced pain threshold</customLabel>
    <promptDescription>dulled nervous system feeling only half normal pain</promptDescription>
    <behavioralDirective>You feel little physical pain. You speak of serious wounds as mild nuisances and rarely show distress when injured.</behavioralDirective>
  </EchoColony.GeneAIPromptDef>

  <EchoColony.GeneAIPromptDef>
    <defName>Prompt_Pain_Extra</defName>
